PROJECT_NAME="SecureAPI Sentinel"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=False

SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

MFA_ISSUER="SecureAPI Sentinel"
MFA_ENCRYPTION_KEY="REPLACE_WITH_A_RANDOM_BASE64_KEY"

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

DATABASE_URL="sqlite+aiosqlite:///./sentinel.db"
DB_ECHO=False

# For Redis integration:
# REDIS_URL="redis://localhost:6379/0"

RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_SIZE_BYTES=10485760

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

