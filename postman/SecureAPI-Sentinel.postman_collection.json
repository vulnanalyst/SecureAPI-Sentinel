    {
      "name": "Security - No Auth Tests",
      "description": "Tests that verify endpoints properly reject unauthenticated requests.",
      "item": [
        {
          "name": "Access Protected Endpoint - No Token (Negative)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"]},
            "description": "Access protected endpoint without any token. Must return 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function() {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('WWW-Authenticate header present', function() {",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Access Protected Endpoint - Invalid Token (Negative)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer invalid.jwt.token"}],
            "url": {"raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"]},
            "description": "Access protected endpoint with an invalid/tampered JWT. Must return 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function() {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('No stack trace in response', function() {",
                  "  var body = pm.response.text();",
                  "  pm.expect(body).to.not.include('Traceback');",
                  "  pm.expect(body).to.not.include('File \"');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Oversized Payload (Security)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"]},
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\", \"payload\": \"\"}"
            },
            "description": "Send a small but non-empty oversized field. The real 10MB test should be done via script. This tests the route is accessible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Not an internal server error', function() {",
                  "  pm.expect(pm.response.code).to.not.eql(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
